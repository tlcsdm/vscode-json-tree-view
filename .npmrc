# typescript@7 removed its programmatic compiler API. typescript-eslint@8.x still
# requires typescript<6.1.0 as a peer dep. Setting legacy-peer-deps=true allows
# npm ci to install without failing on this conflict. The postinstall script then
# installs typescript@6 nested inside node_modules/typescript-eslint/ so that
# typescript-estree resolves the TS6 API at runtime while tsc uses TS7.
legacy-peer-deps=true
